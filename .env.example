# Copy this file to ".env" and fill in your own values.
# The real .env file is ignored by Git so your password is never uploaded.

PORT=3000

# Format: postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/SpendWise

# A long random string used to sign login cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
